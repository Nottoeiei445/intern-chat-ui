{
  "raster_image": {
    "description": "สำหรับข้อมูลภาพทั้งหมด (WMS, WMTS, TMS) เช่น ภาพถ่ายดาวเทียม, เรดาร์ฝน, หรือ Heatmap ที่เรนเดอร์มาแล้ว",
    "renderConfig": {
      "layerType": "raster",
      "paint": {
        "raster-opacity": 0.8,
        "raster-fade-duration": 300
      }
    }
  },

  "vector_polygon": {
    "description": "สำหรับข้อมูลเวกเตอร์ประเภทพื้นที่ (Polygon) เช่น ขอบเขตจังหวัด, พื้นที่น้ำท่วม",
    "renderConfig": {
      "layerType": "fill",
      "paint": {
        "fill-color": ["case", ["boolean", ["feature-state", "hover"], false], "#facc15", "#3b82f6"],
        "fill-opacity": ["case", ["boolean", ["feature-state", "hover"], false], 0.8, 0.4],
        "fill-outline-color": "#2563eb"
      }
    }
  },

  "vector_line": {
    "description": "สำหรับข้อมูลเวกเตอร์ประเภทเส้น (Line) เช่น ถนน, แม่น้ำ",
    "renderConfig": {
      "layerType": "line",
      "paint": {
        "line-color": ["case", ["boolean", ["feature-state", "hover"], false], "#facc15", "#10b981"],
        "line-width": ["case", ["boolean", ["feature-state", "hover"], false], 5, 2.5]
      }
    }
  },

  "vector_point": {
    "description": "สำหรับข้อมูลเวกเตอร์ประเภทจุด (Point) ที่ต้องการแสดงเป็นจุดหมุด",
    "renderConfig": {
      "layerType": "circle",
      "paint": {
        "circle-color": ["case", ["boolean", ["feature-state", "hover"], false], "#facc15", "#ef4444"],
        "circle-radius": ["case", ["boolean", ["feature-state", "hover"], false], 8, 5],
        "circle-stroke-width": 1.5,
        "circle-stroke-color": "#ffffff"
      }
    }
  },

  "vector_point_heatmap": {
    "description": "สำหรับข้อมูลเวกเตอร์ประเภทจุด (Point) ที่ต้องการแปลงให้เป็นแผนที่ความร้อน (Heatmap)",
    "renderConfig": {
      "layerType": "heatmap",
      "paint": {
        "heatmap-weight": 1,
        "heatmap-intensity": ["interpolate", ["linear"], ["zoom"], 0, 1, 9, 3],
        "heatmap-color": ["interpolate", ["linear"], ["heatmap-density"], 0, "rgba(255,255,255,0)", 0.2, "rgb(254,204,92)", 0.5, "rgb(240,59,32)", 1, "rgb(189,0,38)"],
        "heatmap-radius": ["interpolate", ["linear"], ["zoom"], 0, 5, 9, 15],
        "heatmap-opacity": 0.8
      }
    }
  }
}